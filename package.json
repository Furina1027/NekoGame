{
  "name": "nekogame",
  "version": "2.3.17",
  "main": "electron/main.js",
  "description": "抽卡分析与游戏时长管理工具，基于 Neko Game 二次开发",
  "author": "Furina1027",
  "contributors": [
    {
      "name": "Summer-Neko",
      "url": "https://github.com/Summer-Neko/NekoGame"
    }
  ],
  "license": "GPL-3.0",
  "homepage": "https://github.com/Furina1027/NekoGame",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Furina1027/NekoGame.git"
  },
  "bugs": {
    "url": "https://github.com/Furina1027/NekoGame/issues"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5273 && cross-env VITE_DEV_SERVER_URL=http://localhost:5273 electron .",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build:vite": "vite build",
    "build": "npm run typecheck && vite build",
    "dist": "npm run build && electron-builder",
    "start": "npm run build:vite && electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "gacha",
    "genshin-impact",
    "honkai-star-rail",
    "zenless-zone-zero",
    "playtime-tracker"
  ],
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.2",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-scroll-area": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "axios": "^1.7.7",
    "better-sqlite3": "^12.10.0",
    "chart.js": "^4.4.6",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "echarts": "^5.6.0",
    "exceljs": "^4.4.0",
    "fs-extra": "^11.2.0",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.469.0",
    "node-fetch": "^3.3.2",
    "ps-node": "^0.1.6",
    "qrcode": "^1.5.4",
    "qs": "^6.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1",
    "sqlite3": "^5.1.7",
    "swiper": "^11.1.15",
    "tailwind-merge": "^2.6.0",
    "winreg": "^1.2.5",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "com.wenpeng.nekogame",
    "productName": "NekoGame",
    "copyright": "Copyright © 2023 Summer-Neko (原项目) | 二次开发 © 2026 Furina1027 | GPL-3.0",
    "releaseInfo": {
      "releaseNotesFile": "release-notes.md"
    },
    "extraMetadata": {
      "version": "2.3.17"
    },
    "files": [
      "assets/**/*",
      "electron/**/*",
      "out/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/sqlite3/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
